#!/usr/bin/env python3
"""CUPS filter wrapper: rastertoepson + continuous-form double-feed fix.

Stock rastertoepson feeds the FULL page height in line feeds and THEN sends
FF. On continuous forms whose length equals the page (5.5in slips, ESC C 33)
the paper is already at the next top-of-form when the FF arrives, so the FF
ejects one entire blank form per page — every print "takes two papers".

This wrapper runs the stock driver and strips the run of top-level line feeds
immediately preceding each FF, so the FF itself closes the page. Graphics
blocks (ESC *) are copied opaquely; their data bytes are never touched.

Install (must be root-owned or cupsd refuses to exec it):
  sudo cp rastertoepson-lq310 /usr/lib/cups/filter/ && \
  sudo chown root:root /usr/lib/cups/filter/rastertoepson-lq310 && \
  sudo chmod 755 /usr/lib/cups/filter/rastertoepson-lq310
PPD hooks it via: *cupsFilter: "application/vnd.cups-raster 50 rastertoepson-lq310"
"""

import subprocess
import sys

REAL = "/usr/lib/cups/filter/rastertoepson"


def strip_prepage_feeds(d: bytes) -> bytes:
    out = bytearray()
    i, n = 0, len(d)
    while i < n:
        b = d[i]
        if b == 0x1B and i + 1 < n:
            c = d[i + 1]
            if c == ord("*") and i + 4 < n:  # graphics: ESC * m nL nH data
                m, cols = d[i + 2], d[i + 3] + 256 * d[i + 4]
                bpc = 6 if m in (71, 72, 73) else 3 if m >= 32 else 1
                j = min(n, i + 5 + cols * bpc)
                out += d[i:j]
                i = j
                continue
            # ESC C NUL n (form length inches) is 4 bytes, all other
            # two-arg commands used by this driver are 3, the rest 2.
            if c == ord("C") and i + 2 < n and d[i + 2] == 0:
                j = i + 4
            elif c in b"C3JQlxUN$r+":
                j = i + (4 if c == ord("$") else 3)
            else:
                j = i + 2
            out += d[i:j]
            i = j
            continue
        if b == 0x0C:  # form feed: drop the blank feed run before it
            while out and out[-1] == 0x0A:
                out.pop()
            out.append(b)
            i += 1
            continue
        out.append(b)
        i += 1
    return bytes(out)


def main() -> int:
    proc = subprocess.Popen([REAL] + sys.argv[1:], stdout=subprocess.PIPE)
    data = proc.stdout.read()
    rc = proc.wait()
    if rc != 0:
        return rc
    sys.stdout.buffer.write(strip_prepage_feeds(data))
    sys.stdout.buffer.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
