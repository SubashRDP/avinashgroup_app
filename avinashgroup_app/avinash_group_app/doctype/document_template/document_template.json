   "fieldtype": "Table",
   "label": "Data Sources",
   "options": "Document Template Data Source"
  },
  {
   "collapsible": 1,
   "fieldname": "header_footer_section",
   "fieldtype": "Section Break",
   "label": "Header & Footer",
   "depends_on": "eval:!doc.is_memo"
  },
  {
   "fieldname": "hf_help",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted small\"><b>Email</b> renders this header/footer on every page (digital letterhead). <b>Print (letterhead paper)</b> leaves the same amount of blank space at top/bottom (set by the heights) but does <b>not</b> draw them — for printing on your pre-printed letterhead. Set the heights to match your pre-printed header/footer band. Supports Jinja; leave empty to fall back to the linked Letter Head.</p>"
  },
  {
   "description": "Header HTML (repeats on every page).",
   "fieldname": "header_html",
   "fieldtype": "Code",
   "options": "HTML",
   "label": "Header HTML"
  },
  {
   "default": "25",
   "description": "Reserved header height in mm (top page margin).",
   "fieldname": "header_height",
   "fieldtype": "Float",
   "label": "Header Height (mm)"
  },
  {
   "fieldname": "column_break_hf",
   "fieldtype": "Column Break"
  },
  {
   "description": "Footer HTML (repeats on every page).",
   "fieldname": "footer_html",
   "fieldtype": "Code",
   "options": "HTML",
   "label": "Footer HTML"
  },
  {
   "default": "15",
   "description": "Reserved footer height in mm (bottom page margin).",
   "fieldname": "footer_height",
   "fieldtype": "Float",
   "label": "Footer Height (mm)"
  },
  {
   "fieldname": "body_section",
   "fieldtype": "Section Break",
   "label": "Document Body (HTML + Jinja)",
   "depends_on": "eval:!doc.is_memo"
  },
  {
   "fieldname": "body_help",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted small\">Write the document as HTML. Use placeholders from your data sources, e.g. <code>{{ data.sales.row.total }}</code> (single value) or loop rows with <code>{% for r in data.totals.rows %}...{% endfor %}</code>. Inputs are available as <code>{{ inputs.company }}</code>, plus <code>{{ company }}</code>, <code>{{ today }}</code> and <code>{{ fmt(value) }}</code>. Use the <b>Preview</b> button to see it rendered.</p>"
  },
  {
   "description": "The document template as raw HTML + Jinja. Rendered with your data at generation time; the user can then edit the result before printing/emailing.",
   "fieldname": "body_html",
   "fieldtype": "Code",
   "options": "HTML",
   "label": "Body HTML"
  }
