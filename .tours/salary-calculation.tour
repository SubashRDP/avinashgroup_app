{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Salary calculation: punch to journal",
  "description": "Every function that turns a biometric punch into a salary slip and its journal, in the order it runs. Same steps as docs/salary-code-map.md.",
  "isPrimary": false,
  "steps": [
    {
      "file": "docs/salary-code-map.md",
      "line": 1,
      "title": "Salary code map",
      "description": "The overview page for this tour: the pipeline picture, the same steps as tables, and the settings that change the result."
    },
    {
      "file": "avinashgroup_app/biometric/iclock.py",
      "line": 39,
      "title": "1.1 IclockRenderer.render",
      "description": "Page renderer for `/iclock/*` (ZKTeco ADMS push); `cdata` goes to `_handle_cdata`, every other endpoint is answered `OK`.\n\nReads: `hooks.py` `page_renderer`; query `SN`"
    },
    {
      "file": "avinashgroup_app/biometric/iclock.py",
      "line": 87,
      "title": "1.2 _handle_cdata",
      "description": "GET returns the config block; POST with `table=ATTLOG` parses the punches and commits; other tables are acknowledged only.\n\nReads: Request body"
    },
    {
      "file": "avinashgroup_app/biometric/iclock.py",
      "line": 129,
      "title": "1.3 _process_attlog",
      "description": "Drops the batch if the serial is unknown, splits tab-separated lines into `{user_id, timestamp}`, hands them to `process_attendance_records`.\n\nReads: Biometric Device"
    },
    {
      "file": "avinashgroup_app/biometric/api.py",
      "line": 10,
      "title": "1.4 receive_attendance",
      "description": "Whitelisted POST used by the bridge (push model): checks the device, validates the JSON list, calls `process_attendance_records`.\n\nReads: Biometric Device"
    },
    {
      "file": "avinashgroup_app/biometric/utils.py",
      "line": 14,
      "title": "1.5 assert_known_device",
      "description": "Throws PermissionError (403) unless a Biometric Device with this `device_serial` is enabled.\n\nReads: Biometric Device `device_serial`, `enabled`"
    },
    {
      "file": "avinashgroup_app/biometric/utils.py",
      "line": 107,
      "title": "1.6 process_attendance_records",
      "description": "Groups punches by (device user ID, date), finds the employee, reconciles each group under its own savepoint; returns synced / skipped / failed lists.\n\nReads: Biometric Device `company`, `duplicate_threshold_seconds`"
    },
    {
      "file": "avinashgroup_app/biometric/utils.py",
      "line": 48,
      "title": "1.7 resolve_employee_for_punch",
      "description": "The employee whose `attendance_device_id` is the user ID in the device's company; on a miss, the device's Allowed Employees list.\n\nReads: Employee `attendance_device_id`; Biometric Device Allowed Employee"
    },
    {
      "file": "avinashgroup_app/biometric/utils.py",
      "line": 270,
      "title": "1.8 _reconcile_day_checkins",
      "description": "Keeps existing checkins, drops new punches inside the duplicate threshold, inserts the rest as Employee Checkin, relabels IN/OUT, then calls `sync_day`.\n\nReads: Employee Checkin of the day"
    },
    {
      "file": "avinashgroup_app/biometric/attendance_sync.py",
      "line": 57,
      "title": "1.9 desired_log_type",
      "description": "IN, OUT, IN … in time order, with the day's last punch forced to OUT when there are two or more."
    },
    {
      "file": "avinashgroup_app/biometric/attendance_sync.py",
      "line": 241,
      "title": "1.10 sync_day",
      "description": "Past days only: links the day's unlinked checkins to an existing Present / Half Day Attendance and refreshes its values. Never changes status.\n\nReads: Attendance, Employee Checkin"
    },
    {
      "file": "avinashgroup_app/biometric/attendance_sync.py",
      "line": 172,
      "title": "1.11 refresh_attendance_values",
      "description": "Recomputes working hours, in/out, late/early flags (via `ShiftType.get_attendance`) and the four deviation fields; writes only what changed, with `db.set_value`.\n\nReads: Shift Type"
    },
    {
      "file": "avinashgroup_app/hooks.py",
      "line": 341,
      "title": "1.12 checkin_{_event}",
      "description": "Registers `checkin_after_insert` / `checkin_on_update` / `checkin_after_delete` on Employee Checkin."
    },
    {
      "file": "avinashgroup_app/biometric/attendance_sync.py",
      "line": 350,
      "title": "1.13 checkin_after_insert",
      "description": "A checkin made on the desk or by API: relabel the day and `sync_day`. Skipped while the device pipeline inserts (`in_biometric_day_reconcile`)."
    },
    {
      "file": "avinashgroup_app/biometric/attendance_sync.py",
      "line": 371,
      "title": "1.14 checkin_on_update",
      "description": "Time or log type edited: relabel and sync the old and the new day."
    },
    {
      "file": "avinashgroup_app/biometric/attendance_sync.py",
      "line": 405,
      "title": "1.15 checkin_after_delete",
      "description": "Checkin deleted: relabel and sync its day."
    },
    {
      "file": "avinashgroup_app/biometric/employee.py",
      "line": 13,
      "title": "1.16 validate_unique_device_id",
      "description": "Employee validate: refuses two employees of one company with the same Attendance Device ID, so a punch maps to one person.\n\nReads: Employee `attendance_device_id`, `company`"
    },
    {
      "file": "../hrms/hrms/hooks.py",
      "line": 225,
      "title": "2.1 process_auto_attendance_for_all_shifts",
      "description": "HRMS `hourly_long` scheduler entry."
    },
    {
      "file": "../hrms/hrms/hr/doctype/shift_type/shift_type.py",
      "line": 411,
      "title": "2.2 process_auto_attendance_for_all_shifts",
      "description": "Runs `process_auto_attendance` on every Shift Type with Enable Auto Attendance.\n\nReads: Shift Type `enable_auto_attendance`"
    },
    {
      "file": "../hrms/hrms/hr/doctype/shift_type/shift_type.py",
      "line": 101,
      "title": "2.3 ShiftType.process_auto_attendance",
      "description": "Needs auto attendance, Process Attendance After and Last Sync set; groups unlinked checkins by (employee, shift start), marks each, then marks absents.\n\nReads: Shift Type `process_attendance_after`, `last_sync_of_checkin`"
    },
    {
      "file": "../hrms/hrms/hr/doctype/shift_type/shift_type.py",
      "line": 153,
      "title": "2.4 ShiftType.get_employee_checkins",
      "description": "Checkins of this shift that are unlinked, not skipped, not offshift, and whose shift ended before Last Sync.\n\nReads: Employee Checkin"
    },
    {
      "file": "../hrms/hrms/hr/doctype/employee_checkin/employee_checkin.py",
      "line": 64,
      "title": "2.5 EmployeeCheckin.fetch_shift",
      "description": "Sets the checkin's shift and its start/end and actual start/end from the employee's shift; `offshift` when none.\n\nReads: Shift Assignment, Employee `default_shift`"
    },
    {
      "file": "../hrms/hrms/hr/doctype/shift_type/shift_type.py",
      "line": 179,
      "title": "2.6 ShiftType.get_attendance",
      "description": "Status from the hour thresholds (Absent / Half Day / Present), late entry and early exit from the grace periods.\n\nReads: Shift Type thresholds and grace periods"
    },
    {
      "file": "../hrms/hrms/hr/doctype/employee_checkin/employee_checkin.py",
      "line": 292,
      "title": "2.7 calculate_working_hours",
      "description": "Hours, in-time and out-time by the shift's check-in/out mode and calculation basis.\n\nReads: Shift Type `determine_check_in_and_check_out`, `working_hours_calculation_based_on`"
    },
    {
      "file": "../hrms/hrms/hr/doctype/employee_checkin/employee_checkin.py",
      "line": 197,
      "title": "2.8 mark_attendance_and_link_log",
      "description": "Submits a new Attendance (or updates a leave half day) and links the checkins; on a ValidationError flags them `skip_auto_attendance`."
    },
    {
      "file": "../hrms/hrms/hr/doctype/shift_type/shift_type.py",
      "line": 218,
      "title": "2.9 ShiftType.mark_absent_for_dates_with_no_attendance",
      "description": "Marks Absent on this shift's days that have no attendance.\n\nReads: Holiday List, Shift Assignment"
    },
    {
      "file": "../hrms/hrms/hr/doctype/attendance/attendance.py",
      "line": 41,
      "title": "2.10 Attendance.validate",
      "description": "HRMS checks (status, joining date, duplicates, overlapping shift, employee status), then `check_leave_record`."
    },
    {
      "file": "../hrms/hrms/hr/doctype/attendance/attendance.py",
      "line": 154,
      "title": "2.11 Attendance.check_leave_record",
      "description": "An approved Leave Application on the date sets leave type and status On Leave (Half Day on its half-day date).\n\nReads: Leave Application"
    },
    {
      "file": "avinashgroup_app/hooks.py",
      "line": 228,
      "title": "2.12 attendance_events",
      "description": "Our Attendance `validate` hooks, run in this order (on `validate`, so they also fire for attendance submitted on insert)."
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 531,
      "title": "2.13 set_holiday_flag",
      "description": "Ticks `custom_worked_on_holiday` when the date is in the employee's Holiday List (or the company default).\n\nReads: Employee `holiday_list`, Company `default_holiday_list`"
    },
    {
      "file": "avinashgroup_app/biometric/attendance_override.py",
      "line": 8,
      "title": "2.14 set_shift_deviation_fields",
      "description": "Fills a missing shift from the roster (`get_shift_window`), then writes the four `custom_*` deviation fields.\n\nReads: Shift Type"
    },
    {
      "file": "avinashgroup_app/biometric/attendance_sync.py",
      "line": 138,
      "title": "2.15 compute_shift_deviations",
      "description": "Seconds of late/early entry and early/late exit against shift start and end, rounded to the minute.\n\nReads: Shift Type `start_time`, `end_time`"
    },
    {
      "file": "avinashgroup_app/biometric/attendance_override.py",
      "line": 55,
      "title": "2.16 enforce_late_arrival_half_day",
      "description": "In-time strictly after shift start + `custom_half_day_if_late_by_hours` (0 = off) → Half Day with `half_day_status` Absent; an excused day goes to `_undo_excused_late_half_day`.\n\nReads: Shift Type `custom_half_day_if_late_by_hours`; Attendance `custom_late_excused`"
    },
    {
      "file": "avinashgroup_app/biometric/attendance_override.py",
      "line": 115,
      "title": "2.17 _undo_excused_late_half_day",
      "description": "Puts an excused late half day back to Present, unless it has a leave type or the hours are below the half-day threshold.\n\nReads: Shift Type `working_hours_threshold_for_half_day`"
    },
    {
      "file": "avinashgroup_app/biometric/attendance_override.py",
      "line": 141,
      "title": "2.18 half_day_when_working_on_leave",
      "description": "On Leave from a leave application but punched in → Half Day, `half_day_status` Present, leave type kept.\n\nReads: Attendance `leave_application`"
    },
    {
      "file": "avinashgroup_app/biometric/attendance_self_heal.py",
      "line": 58,
      "title": "2.19 heal_unlinked_checkins",
      "description": "Daily (`daily_long`, midnight): every (employee, day) of the last 45 days with unlinked checkins, whose shift has auto attendance on and has ended, goes through `reconcile_employee_day`.\n\nReads: Shift Type `enable_auto_attendance`, `last_sync_of_checkin`, `process_attendance_after`"
    },
    {
      "file": "avinashgroup_app/avinash_group_app/doctype/attendance_fix/attendance_fix.py",
      "line": 266,
      "title": "2.20 reconcile_employee_day",
      "description": "A non-Absent day: link orphan punches and refresh values. An Absent or empty day with punches: replace it with attendance built by `get_attendance` + `mark_attendance_and_link_log`.\n\nReads: Employee Checkin, Attendance"
    },
    {
      "file": "avinashgroup_app/avinash_group_app/doctype/attendance_fix/attendance_fix.py",
      "line": 90,
      "title": "2.21 AttendanceFix.on_submit",
      "description": "HR's Attendance Fix: queues the same per-day reconcile over a date range for one shift.\n\nReads: Attendance Fix"
    },
    {
      "file": "avinashgroup_app/hr/shift_day.py",
      "line": 111,
      "title": "2.22 measure_day",
      "description": "Late and early-exit minutes (full working days only) and overtime hours to the half hour (OT-eligible only) for one Attendance row. Used by the attendance reports and the Late Time rule (4.13).\n\nReads: Attendance `custom_*` deviation fields"
    },
    {
      "file": "avinashgroup_app/avinash_group_app/doctype/overtime_sheet/overtime_sheet.py",
      "line": 55,
      "title": "3.1 OvertimeSheet.apply_rules",
      "description": "Sheet validate: runs `evaluate` on every row, writes back work type, day type, entitlement, shift; lists all refused rows at once."
    },
    {
      "file": "avinashgroup_app/hr/overtime.py",
      "line": 150,
      "title": "3.2 evaluate",
      "description": "Day type × the employee's two ticks → entitlement Overtime or Replacement Leave; refuses rows the policy does not allow.\n\nReads: Employee `custom_ot_eligibility`, `custom_compensatory_leave`"
    },
    {
      "file": "avinashgroup_app/hr/overtime.py",
      "line": 60,
      "title": "3.3 get_day_type",
      "description": "Holiday, Weekly Off or Working Day from the employee's own holiday list.\n\nReads: Holiday List"
    },
    {
      "file": "avinashgroup_app/hr/overtime.py",
      "line": 91,
      "title": "3.4 get_shift_window",
      "description": "The shift rostered on a date (dated Shift Assignment, else Default Shift) with its start and end datetimes.\n\nReads: Shift Assignment, Employee `default_shift`, Shift Type"
    },
    {
      "file": "avinashgroup_app/hr/overtime.py",
      "line": 121,
      "title": "3.5 get_holiday_work_rule",
      "description": "The Employee's Overtime Eligible / Replacement Leave for Holiday Work ticks (either/or, enforced by `validate_employee_holiday_rule`).\n\nReads: Employee `custom_ot_eligibility`, `custom_compensatory_leave`"
    },
    {
      "file": "avinashgroup_app/hr/overtime_settlement.py",
      "line": 203,
      "title": "3.6 on_sheet_submit",
      "description": "Sheet submit: measures the never-measured rows if the work date is already past."
    },
    {
      "file": "avinashgroup_app/hr/overtime_settlement.py",
      "line": 214,
      "title": "3.7 measure_pending",
      "description": "Daily job: measures never-measured rows of submitted sheets from the last 62 days."
    },
    {
      "file": "avinashgroup_app/hr/overtime_settlement.py",
      "line": 140,
      "title": "3.8 measure",
      "description": "The sheet's Measure button: re-measures every row (`measure_sheet`)."
    },
    {
      "file": "avinashgroup_app/hr/overtime_settlement.py",
      "line": 80,
      "title": "3.9 measure_row",
      "description": "Holiday work: hours worked; overtime: hours outside the shift; both rounded to the half hour. 0 hours with a note when there is no attendance, it is Absent, or there is one punch.\n\nReads: Attendance, Shift Type"
    },
    {
      "file": "avinashgroup_app/hr/overtime.py",
      "line": 320,
      "title": "3.10 hours_outside_shift",
      "description": "Hours of the in–out window that fall before shift start or after shift end."
    },
    {
      "file": "avinashgroup_app/hr/shift_day.py",
      "line": 42,
      "title": "3.11 round_to_half_hour",
      "description": "Nearest half hour, halves rounding up."
    },
    {
      "file": "avinashgroup_app/public/js/payroll_entry.js",
      "line": 358,
      "title": "4.1 Prepare Payroll Inputs",
      "description": "The button; after a confirm it calls `trigger_for_payroll_entry`."
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 78,
      "title": "4.2 trigger_for_payroll_entry",
      "description": "Runs `create_additional_salaries`, then `post_recoveries`, then `refresh_draft_slips`, and commits.\n\nReads: Payroll Entry"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 152,
      "title": "4.3 create_additional_salaries",
      "description": "For each employee × attendance component: skip if not paid, price it, count it, write `qty × rate` as an Additional Salary under a savepoint.\n\nReads: Payroll Entry `start_date`, `end_date`, `employees`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 674,
      "title": "4.4 get_attendance_driven_components",
      "description": "Enabled Salary Components with `custom_is_attendance_driven`.\n\nReads: Salary Component"
    },
    {
      "file": "avinashgroup_app/payroll/allowance.py",
      "line": 285,
      "title": "4.5 get_employee_allowance_rows",
      "description": "`{allowance: row}` from the Allowances table of the assignment in force; rows with a later From Date are left out.\n\nReads: Salary Structure Assignment → Assignment Allowance"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 714,
      "title": "4.6 _gets",
      "description": "An allowance is paid only with a row on the assignment; a non-allowance (late fine) only when the structure lists it.\n\nReads: Salary Component `custom_is_allowance`; Salary Structure rows"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 644,
      "title": "4.7 _skip_for_eligibility",
      "description": "Skips OT-only components for staff not OT eligible, and late components for staff marked late-fine exempt.\n\nReads: Salary Component `custom_ot_eligible_only`; Employee `custom_ot_eligibility`, `custom_late_fine_exempt`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 732,
      "title": "4.8 _resolve_rate",
      "description": "`Hourly Basic × Multiplier` components: hourly basic × multiplier; otherwise the Rate on the person's row; None if neither.\n\nReads: Salary Component `custom_rate_basis`, `custom_rate_multiplier`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 482,
      "title": "4.9 _hourly_basic",
      "description": "Assignment `base` ÷ days per month ÷ hours per day. Days: the actual length of the BS month being priced (29–32) unless the component fixes it; hours: 8 when blank.\n\nReads: Salary Component `custom_rate_days_per_month`, `custom_rate_hours_per_day`; assignment `base`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 663,
      "title": "4.10 _attendance_period",
      "description": "The payroll's own dates, or the previous BS month when the component's Attendance Month is Previous Month.\n\nReads: Salary Component `custom_attendance_month`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 251,
      "title": "4.11 _qty_for_employee",
      "description": "Sums `evaluate_rule` over the period's submitted Attendance; `Flat per Period` gives 1 if any day matched.\n\nReads: Salary Component `custom_unit`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 683,
      "title": "4.12 _attendance_rows",
      "description": "The employee's submitted Attendance rows in the period, with the deviation and holiday fields.\n\nReads: Attendance"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 273,
      "title": "4.13 evaluate_rule",
      "description": "One day's quantity by the component's condition: Present, Half Day, Worked on Holiday, Meal Entitlement, Authorised Overtime, Late Time, Early Entry / Late Stay / Late Arrival.\n\nReads: Salary Component `custom_condition_type`, `custom_unit`, `custom_pay_on_holiday`, `custom_half_day_counts`, `custom_time_offset_hours`; Attendance `custom_late_excused`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 359,
      "title": "4.14 _meals_for_day",
      "description": "OT-eligible and on an Overtime Sheet that day: 2 on a holiday, else 1 each for coming early / staying late by the offset; capped at max per day.\n\nReads: Employee `custom_ot_eligibility`; Salary Component `custom_time_offset_hours`, `custom_max_per_day`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 414,
      "title": "4.15 _on_overtime_sheet",
      "description": "Whether a submitted Overtime Sheet names the employee on the date with the Overtime entitlement.\n\nReads: Overtime Sheet"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 440,
      "title": "4.16 _authorised_overtime_hours",
      "description": "Sum of `worked_hours` on submitted Overtime Sheet rows for the employee and date (the hours from 3.9).\n\nReads: Overtime Sheet Employee `worked_hours`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 769,
      "title": "4.17 _delete_existing_draft",
      "description": "Cancels and deletes this calculator's earlier row for the same employee, component and date; hand-made rows are left.\n\nReads: Additional Salary `custom_source`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 806,
      "title": "4.18 _make_additional_salary",
      "description": "Inserts and submits the Additional Salary with qty and rate kept; earnings get `deduct_full_tax_on_selected_payroll_date`.\n\nReads: Salary Component `type`"
    },
    {
      "file": "avinashgroup_app/payroll/advance_recovery.py",
      "line": 61,
      "title": "4.19 post_recoveries",
      "description": "For each open Employee Advance: the smaller of the instalment and the balance, as a submitted `Salary Advance` deduction linked to the advance.\n\nReads: Employee Advance `custom_monthly_instalment`, `custom_recover_from`, `repay_unclaimed_amount_from_salary`"
    },
    {
      "file": "avinashgroup_app/payroll/advance_recovery.py",
      "line": 117,
      "title": "4.20 clear_month",
      "description": "Cancels the recoveries an earlier press posted into this month.\n\nReads: Additional Salary `custom_source`"
    },
    {
      "file": "avinashgroup_app/payroll/attendance_allowance.py",
      "line": 108,
      "title": "4.21 refresh_draft_slips",
      "description": "Re-saves the entry's draft salary slips so they pick up what was just posted.\n\nReads: Salary Slip (draft)"
    },
    {
      "file": "avinashgroup_app/payroll/payroll_month.py",
      "line": 121,
      "title": "5.1 default_month",
      "description": "The month a new entry opens on: after the company's last payroll, never past the running month.\n\nReads: Payroll Entry"
    },
    {
      "file": "avinashgroup_app/payroll/payroll_entry.py",
      "line": 56,
      "title": "5.2 AvinashPayrollEntry.validate",
      "description": "`fill_from_bs_month`, then HRMS's validate, then `warn_missing_attendance` on a new entry or changed month."
    },
    {
      "file": "avinashgroup_app/payroll/payroll_month.py",
      "line": 45,
      "title": "5.3 fill_from_bs_month",
      "description": "From Fiscal Year + BS month: start, end, posting date (month end), Monthly, currency, payable account, cost centre, and the employee list.\n\nReads: Company defaults; Nepal BS Period / BS calendar"
    },
    {
      "file": "avinashgroup_app/payroll/payroll_month.py",
      "line": 77,
